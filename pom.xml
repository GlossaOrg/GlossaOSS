<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.relism</groupId>
    <artifactId>glossa-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Glossa (parent)</name>
    <description>How Glossa is built: its versions, its repositories, its jar.</description>

    <!--
      This POM is the build; `backend` is Glossa. A compiler setting, a Flash version or the way the
      jar is assembled is written here once, and every module that inherits this POM is built the
      same way. A module carries only what is its own: its dependencies and the class its jar starts.
    -->
    <modules>
        <module>backend</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The Vite project a module serves, beside it. -->
        <vite.root>${project.basedir}/../frontend</vite.root>

        <!--
          A build published by Flash's CI (https://git.pixel-services.com/Relism/Flash5, one
          `2.1.0-<short-sha>` per push to master) from the registry below. To try unreleased Flash
          changes, `mvn install` a Flash checkout and build with -Dflash.version=2.1.0-SNAPSHOT.
        -->
        <flash.version>2.1.0-2798d03</flash.version>

        <!--
          JDAE (https://github.com/Relism/JDAE), built from its tag by JitPack, which serves it
          under `com.github.<owner>.<repo>`. The tag is the version: JitPack does not strip the `v`.
        -->
        <jdae.version>v1.2.1</jdae.version>

        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>5.11.0</junit.version>

        <!--
          hibernate-core itself comes transitively from flash-ext-data-hibernate below —
          don't redeclare it here, or it can drift from what Flash pins in
          flash-extensions/pom.xml and put two Hibernate versions on the classpath.
          HikariCP's version is copied from that same dependencyManagement block.
        -->
        <hikaricp.version>6.3.0</hikaricp.version>
        <postgresql.version>42.7.4</postgresql.version>
        <flyway.version>13.0.0</flyway.version>

        <!-- Same version Flash pins — Flash's own code (and flash-ext-data-hibernate) already uses Lombok. -->
        <lombok.version>1.18.44</lombok.version>

        <!-- Same version Flash pins (flash-extensions/pom.xml) for its own Postgres-backed tests. -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.relism</groupId>
                <artifactId>flash-parent</artifactId>
                <version>${flash.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>gitea-flash</id>
            <name>Gitea Maven Registry (Relism)</name>
            <url>https://git.pixel-services.com/api/packages/Relism/maven</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>gitea-flash</id>
            <url>https://git.pixel-services.com/api/packages/Relism/maven</url>
        </pluginRepository>
        <pluginRepository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <!-- A jar is named after its module: glossa.jar. -->
        <finalName>${project.artifactId}</finalName>

        <!--
          What builds a jar, configured here and declared by the module that has one. Managed rather
          than inherited outright: an execution inherited by this POM would run against it too, and
          a parent has no sources, no frontend and no jar to shade.
        -->
        <pluginManagement>
            <plugins>
                <!--
                  Rewrites the compiled classes at process-classes, before the tests read the spec:
                  each documentation annotation is replaced by the flash-ext-openapi annotations its
                  expander builds. Expanders and the classes they name are loaded from this module's
                  own compile classpath.
                -->
                <plugin>
                    <groupId>com.github.Relism.JDAE</groupId>
                    <artifactId>jdae-maven-plugin</artifactId>
                    <version>${jdae.version}</version>
                    <executions>
                        <execution>
                            <goals><goal>expand-annotations</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Builds frontend/ at prepare-package into the jar, so `mvn package` makes a jar that serves
                     its own frontend and `mvn test` needs no Node. -->
                <plugin>
                    <groupId>dev.relism</groupId>
                    <artifactId>flash-ext-vite-maven-plugin</artifactId>
                    <version>${flash.version}</version>
                    <configuration>
                        <root>${vite.root}</root>
                    </configuration>
                    <executions>
                        <execution>
                            <goals><goal>build</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals><goal>shade</goal></goals>
                            <configuration>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>${main.class}</mainClass>
                                    </transformer>
                                    <!-- Without this, only one dependency's META-INF/services/* file per
                                         interface survives shading instead of all of them being merged —
                                         silently breaks Flyway's own database-type ServiceLoader lookup
                                         (flyway-database-postgresql). -->
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Configuration only: nothing here runs against a POM that builds nothing. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!--
                          Writes a validation adapter for every type annotated @Valid: the engine
                          reads no annotations at runtime, so a type without its adapter is refused
                          by name on the first request. The version comes from the Flash BOM.
                        -->
                        <path>
                            <groupId>io.avaje</groupId>
                            <artifactId>avaje-validator-generator</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Same two settings the dev run and the Dockerfile pass, so test output
                         reads like production output. Both must be set at JVM start, hence
                         argLine rather than systemPropertyVariables. -->
                    <argLine>-Dorg.jboss.logging.provider=slf4j -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                    <environmentVariables>
                        <!-- §9: a throwaway key, so the AI provider's stored credential is sealed in
                             tests exactly as in production. Env reads the environment first. -->
                        <ENCRYPTION_KEY>dGVzdC1vbmx5LWtleS10ZXN0LW9ubHkta2V5LTMyYnk=</ENCRYPTION_KEY>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
