<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.relism</groupId>
    <artifactId>glossa</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Glossa</name>
    <description>Translation management system built on Flash.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          A build published by Flash's CI (https://git.pixel-services.com/Relism/Flash5, one
          `2.1.0-<short-sha>` per push to master) from the registry below. To try unreleased Flash
          changes, `mvn install` a Flash checkout and build with -Dflash.version=2.1.0-SNAPSHOT.
        -->
        <flash.version>2.1.0-8353033</flash.version>

        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>5.11.0</junit.version>

        <!--
          hibernate-core itself comes transitively from flash-ext-data-hibernate below —
          don't redeclare it here, or it can drift from what Flash pins in
          flash-extensions/pom.xml and put two Hibernate versions on the classpath.
          HikariCP's version is copied from that same dependencyManagement block.
        -->
        <hikaricp.version>6.3.0</hikaricp.version>
        <postgresql.version>42.7.4</postgresql.version>
        <flyway.version>13.0.0</flyway.version>

        <!-- Same version Flash pins — Flash's own code (and flash-ext-data-hibernate) already uses Lombok. -->
        <lombok.version>1.18.44</lombok.version>

        <!-- Same version Flash pins (flash-extensions/pom.xml) for its own Postgres-backed tests. -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencies>
        <!-- ICU MessageFormat and versioned CLDR rules for localized messages (§6). -->
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>78.3</version>
        </dependency>
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash</artifactId>
            <version>${flash.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Postgres is the only persistent datastore (docs/REQUIREMENTS.md §2). This is Flash's
          own Hibernate repository layer, wired into the same @Transactional/Tx/TxManager
          system as the rest of the extension graph — see Flash's flash-ext-data-hibernate
          and flash-ext-data-core.
        -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-data-hibernate</artifactId>
            <version>${flash.version}</version>
        </dependency>

        <!-- JSON marshalling for the admin API and the public delivery API (§10). -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-jackson</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <!-- OpenAPI spec + Swagger UI — the delivery API is a public integration surface (§10). -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-openapi</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <!-- Request validation (jakarta constraints, compiled once per type) for the write API. -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-validation</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <!-- §10: "The public delivery API must be rate-limited". -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-limiter</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <!-- §11: SSO, password sign-in and API keys, each optional, all on one security chain. -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-security-oidc</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-security-form</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-security-apikey</artifactId>
            <version>${flash.version}</version>
        </dependency>
        <!-- §13: serves and (in dev) orchestrates the React SPA under web/. -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-vite</artifactId>
            <version>${flash.version}</version>
        </dependency>

        <!--
          flyway-core pulls Jackson 3 (tools.jackson.core:jackson-databind), whose own POM
          notes annotations "remain at Jackson 2.x group id" and requires
          com.fasterxml.jackson.core:jackson-annotations 2.21+. flash-ext-jackson's
          jackson-databind transitively pulls a 2.17.x jackson-annotations, which Maven picks
          by default (nearer in the tree) — too old for Jackson 3's databind, causing a
          NoClassDefFoundError at Flyway boot. jackson-annotations is additive/backward
          compatible across minor versions, so pinning it up here satisfies both. Same fix
          ../Pathway carries for the same flyway+flash-ext-jackson pairing.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.21</version>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- flyway-database-postgresql is discovered via classpath service-loading; no direct code reference needed. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Boots the real app on an ephemeral port and asserts against real responses. -->
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-testing</artifactId>
            <version>${flash.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.relism</groupId>
            <artifactId>flash-ext-security-test</artifactId>
            <version>${flash.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Real Postgres in a container — no mocking a real DB's behavior. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Flash and its own dependencies, public and anonymous: no settings.xml, no credentials. -->
    <repositories>
        <repository>
            <id>gitea-flash</id>
            <name>Gitea Maven Registry (Relism)</name>
            <url>https://git.pixel-services.com/api/packages/Relism/maven</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>gitea-flash</id>
            <url>https://git.pixel-services.com/api/packages/Relism/maven</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <finalName>glossa</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Same two settings the dev run and the Dockerfile pass, so test output
                         reads like production output. Both must be set at JVM start, hence
                         argLine rather than systemPropertyVariables. -->
                    <argLine>-Dorg.jboss.logging.provider=slf4j -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <!--
              The dev loop: `mvn compile exec:exec@dev` runs Main off target/classes, skipping the
              shade that `package` would otherwise redo on every edit. `exec` and not `java`: the
              latter runs Main inside Maven's own JVM under an isolated classloader, where SLF4J
              finds no provider (all logging silently vanishes) and Vite's dev server never comes
              up. This forks a real JVM instead, identical to `java -jar`.
              exec:exec has no default phase binding, so declaring the goal here does not attach
              it to a build.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>dev</id>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-Dflash.env=dev</argument>
                                <!-- Hibernate logs through JBoss Logging, which picks JUL over
                                     SLF4J unless told otherwise — without this its output is the
                                     odd two-line JUL format among everyone else's SLF4J lines.
                                     The Dockerfile sets the same property for the image. -->
                                <argument>-Dorg.jboss.logging.provider=slf4j</argument>
                                <!-- No LANG is set in a bare shell or container, so stdout
                                     defaults to ASCII and every non-ASCII character in a log
                                     line (or a translated string — this is a translation tool)
                                     prints as `?`. -->
                                <argument>-Dstdout.encoding=UTF-8</argument>
                                <argument>-Dstderr.encoding=UTF-8</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>dev.relism.glossa.Main</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Builds web/ at prepare-package into the jar, so `mvn package` makes a jar that serves
                 its own frontend and `mvn test` needs no Node. -->
            <plugin>
                <groupId>dev.relism</groupId>
                <artifactId>flash-ext-vite-maven-plugin</artifactId>
                <version>${flash.version}</version>
                <executions>
                    <execution>
                        <goals><goal>build</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.relism.glossa.Main</mainClass>
                                </transformer>
                                <!-- Without this, only one dependency's META-INF/services/* file per
                                     interface survives shading instead of all of them being merged —
                                     silently breaks Flyway's own database-type ServiceLoader lookup
                                     (flyway-database-postgresql). -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>
