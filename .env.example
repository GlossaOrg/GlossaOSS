# Copy to .env and fill in real values for local dev. A real exported env var (shell, Docker,
# CI, systemd) always takes precedence over .env — see Env.java.
# Never commit .env; only this file.

PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/glossa
DB_USERNAME=glossa
DB_PASSWORD=changeme

# The LibreTranslate sidecar that backs automatic translation suggestions (REQUIREMENTS §2, §9).
LIBRETRANSLATE_URL=http://localhost:5000

# SSO for human users (REQUIREMENTS §11). Leave OIDC_ISSUER unset to run without
# authentication — useful for a fresh clone and for tests, never for a deployment. Setting it
# also locks /mcp down: McpExtension auto-detects OidcMiddleware and derives its RFC 8707 /
# RFC 9728 OAuth2 configuration from it with no further config.
# OIDC_ISSUER=https://your-idp.example.com/realms/glossa
# OIDC_CLIENT_ID=glossa
# OIDC_CLIENT_SECRET=changeme
OIDC_REDIRECT_URI=/auth/callback
OIDC_SCOPES=openid profile email
OIDC_ROUTE_PREFIX=/auth
# Scheme for the absolute URLs Glossa publishes about itself (login redirect_uri, and the MCP
# resource identifier both the RFC 9728 document and the token's `aud` are checked against).
# Only consulted when a request carries no X-Forwarded-Proto, i.e. when Glossa is reached
# directly rather than through a TLS-terminating proxy — and that is plain HTTP.
OIDC_SELF_SCHEME=http
OIDC_ROLES_CLAIM=realm_access.roles
