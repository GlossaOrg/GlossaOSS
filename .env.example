# Copy to .env and fill in real values for local dev. A real exported env var (shell, Docker,
# CI, systemd) always takes precedence over .env — see Env.java.
# Never commit .env; only this file.

PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/glossa
DB_USERNAME=glossa
DB_PASSWORD=changeme

# Password sign-in (REQUIREMENTS §11), on unless LOCAL_LOGIN=false. There is no default account:
# on a fresh install the first person to create one on the sign-in screen, or to sign in with SSO,
# administers the install.
#LOCAL_LOGIN=false

# SSO (REQUIREMENTS §11), installed when OIDC_ISSUER is set — here the Keycloak dev/compose.yaml
# starts (realm dev/keycloak/glossa-realm.json, user dev / dev). Register
# {origin}/auth/oidc/sso/callback as a redirect URI. Roles always come from Glossa's database.
OIDC_ISSUER=http://localhost:8081/realms/glossa
OIDC_CLIENT_ID=glossa
OIDC_CLIENT_SECRET=dev-secret
OIDC_SCOPES=openid profile email

# REQUIREMENTS §9: AI features are off until an administrator turns them on in Settings and names an
# OpenAI-compatible provider. This key seals the provider's API key in the database; generate one with
#   head -c 32 /dev/urandom | base64
# and keep it: rotate it and the stored key has to be entered again.
# dev.sh exports a well-known one when this is unset, which is fine locally and nowhere else.
#ENCRYPTION_KEY=

# Where the installation is served. Sign-in callbacks and secure cookies are built from it; unset, each
# request's own Host header is used, which is only good enough for local development.
#ORIGIN=https://glossa.example
